# Copy to .env for local dev (not committed), or set these as environment
# variables on the Node.js app in cPanel for production. Never commit real
# values.

# --- Peach Payments (get these from the Peach Payments Dashboard > API keys) ---
PEACH_CLIENT_ID=
PEACH_CLIENT_SECRET=
PEACH_MERCHANT_ID=
PEACH_ENTITY_ID=

# Shared secret used to verify webhook signatures (Dashboard > Webhooks).
PEACH_WEBHOOK_SECRET=

# Must exactly match the notification URL registered with Peach for this
# merchant/entity — used both when calling Peach and when verifying the
# signature of inbound webhooks, so a mismatch here breaks payments silently.
PEACH_WEBHOOK_URL=https://thrupass.co.za/webhooks/peach

# Sandbox by default. Verify these hostnames against your own Peach
# Payments dashboard/docs access before going live — swap to the live
# hostnames Peach gives you for production.
PEACH_AUTH_BASE_URL=https://oauth.peachpayments.com
PEACH_API_BASE_URL=https://testapi.peachpayments.com

# --- App ---
# Used to build the shopperResultUrl (where Peach redirects the shopper
# back to after payment).
PUBLIC_BASE_URL=https://thrupass.co.za
